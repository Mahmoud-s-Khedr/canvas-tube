{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@core/*": [
        "./src/core/*"
      ]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/core/**/*",
    "tests/project-service.test.ts",
    "tests/ipc-handlers.test.ts",
    "tests/preload.test.ts",
    "tests/main-window.test.ts",
    "e2e/**/*.ts",
    "playwright.config.ts",
    "tests/project-failures.test.ts"
  ]
}
