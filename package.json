{
  "name": "canvas-tube",
  "version": "0.1.0",
  "description": "Offline desktop infinite-canvas workspace optimized for technical explanations and video recording",
  "main": "./out/main/index.js",
  "author": "canvas-tube contributors",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:linux:debug": "electron-vite build && electron-builder --linux --dir",
    "build:linux:appimage": "electron-vite build && electron-builder --linux AppImage",
    "build:win:debug": "electron-vite build && electron-builder --win --dir",
    "build:win:portable": "electron-vite build && electron-builder --win portable",
    "build:win:nsis": "electron-vite build && electron-builder --win nsis",
    "build:win:all": "electron-vite build && electron-builder --win",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "sync:stencils": "node scripts/sync-official-icons.mjs",
    "lint": "eslint .",
    "benchmark": "tsx scripts/run-benchmarks.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@types/prismjs": "^1.26.6",
    "lucide-react": "^1.16.0",
    "pdfjs-dist": "^6.3.289",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "34.5.8",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.20.1",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vitest": "^3.2.7"
  }
}
